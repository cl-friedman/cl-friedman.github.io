{% assign publications_by_category = site.scholar.bibliography | group_by: 'category' %}
{% for category in publications_by_category %}
  <h2 class="bibliography">{{ category.name }}</h2>
  {% for entry in category.items %}
    {% include bib.liquid %}
  {% endfor %}
{% endfor %}
