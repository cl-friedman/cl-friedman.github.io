---
layout: page
---

<div class="publications">
  <!-- Get all papers -->
  {% assign all_papers = site.scholar.bibliography %}

  <!-- Group them by category -->
  {% assign publications_by_category = all_papers | group_by: 'category' %}

  <!-- 1. Render all categories EXCEPT "Talk" -->
  {% for category in publications_by_category %}
    {% if category.name == 'Talk' %}
      {% continue %}
    {% endif %}
    
    <h2 class="bibliography mt-4">{{ category.name }}</h2>
    {% for entry in category.items %}
      {% include bib.liquid %}
    {% endfor %}
  {% endfor %}

  <!-- 2. Render "Talk" category separately at the bottom -->
  {% assign talk_entries = all_papers | where: "category", "Talk" %}

  {% if talk_entries.size > 0 %}
    <h2 class="bibliography mt-4">Talks</h2>
    {% for entry in talk_entries %}
      {% include bib.liquid %}
    {% endfor %}
  {% endif %}
</div>
